# Anthropic API Credentials
# Copy to anthropic-credentials.yaml and fill in your API key
#
# To create:
# 1. Copy this file: cp anthropic-credentials.yaml.example anthropic-credentials.yaml
# 2. Replace YOUR_API_KEY with your actual Anthropic API key
# 3. Apply: kubectl apply -f anthropic-credentials.yaml
#
# To get an API key: https://console.anthropic.com/
apiVersion: v1
kind: Secret
metadata:
  name: anthropic-credentials
  namespace: default
type: Opaque
stringData:
  api-key: "YOUR_ANTHROPIC_API_KEY_HERE"
