# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Kubernetes Configuration
# Leave empty to use default kubeconfig from ~/.kube/config
# Or specify a custom path
KUBECONFIG_PATH=

# Authentication Database
# PostgreSQL connection string for user authentication
AUTH_DATABASE_URL=

# JWT Configuration
# REQUIRED: Must be a cryptographically secure random string (minimum 32 characters)
# Generate a secure secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# IMPORTANT: Keep this secret private and never commit the actual value to version control!
# SECURITY: Application will fail to start in production if this is not set or uses a weak default
JWT_SECRET=

# JWT Token Expiration (optional, defaults to 24h)
# Examples: 60, "2 days", "10h", "7d"
JWT_EXPIRES_IN=24h

# Logging
LOG_LEVEL=info
